{
  "name": "cloudflare-os",
  "main": ".wrangler/validate/src/server.ts",
  "compatibility_date": "2026-02-02",
  "compatibility_flags": [
    "allow_irrevocable_stub_storage",
    "enhanced_error_serialization",
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_DURABLE_OBJECT",
        "class_name": "UserDurableObject"
      },
      {
        "name": "OVERSEER_DURABLE_OBJECT",
        "class_name": "OverseerDurableObject"
      },
      {
        "name": "ADMIN_SETTINGS",
        "class_name": "AdminSettings"
      },
      {
        "name": "PENDING_LOGIN",
        "class_name": "PendingLogin"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["UserDurableObject", "OverseerDurableObject"]
    },
    {
      "tag": "v1",
      "new_sqlite_classes": ["AdminSettings"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PendingLogin"]
    }
  ],
  "assets": {
    "directory": "cloudflare-os-assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/blueprint-screenshot/*"]
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://agents.yanpla.nl"
  }
}
